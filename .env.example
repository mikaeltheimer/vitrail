# Copier ce fichier en .env.local et remplir. Ne jamais mettre de clés dans le chat ni dans git.

# Adresse publique du site (celle que le QR code ouvre). En local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase : projet NEUF, distinct de celui de Pay to Exist ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Langues ──
# L'anglais est actif par défaut (sélecteur FR/EN, ?lang=en, langue du navigateur, /screen).
# 0 : interrupteur de secours, tout reste en français.
NEXT_PUBLIC_ENGLISH=

# ── Paiement ──
# demo   : aucun paiement, le don est enregistré tout de suite (pour présenter l'outil)
# stripe : vrais paiements (clés de test d'abord : sk_test_…)
# off    : paiements désactivés
# En production, sans PAYMENT_MODE explicite et sans clé Stripe, les paiements sont désactivés (jamais la démo).
PAYMENT_MODE=demo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Console admin (/admin) ──
ADMIN_CODE=
# Longue chaîne aléatoire (32 caractères ou plus) qui signe la session admin
SESSION_SECRET=

# ── Courriels (facultatif en développement : sans clé, ils s'écrivent dans la console du serveur) ──
RESEND_API_KEY=
EMAIL_FROM="École d'art de Sutton <dons@exemple.org>"
