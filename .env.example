# Copier ce fichier en .env.local et remplir. Ne jamais mettre de clés dans le chat ni dans git.

# Adresse publique du site (celle que le QR code ouvre). En local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase : projet NEUF, distinct de celui de Pay to Exist ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Langues ──
# L'anglais est actif par défaut (sélecteur FR/EN, ?lang=en, langue du navigateur, /screen).
# 0 : interrupteur de secours, tout reste en français.
NEXT_PUBLIC_ENGLISH=

# ── Paiement ──
# demo   : aucun paiement, le don est enregistré tout de suite (pour présenter l'outil)
# stripe : vrais paiements (clés de test d'abord : sk_test_…)
# off    : paiements désactivés
# En production, sans PAYMENT_MODE explicite et sans clé Stripe, les paiements sont désactivés (jamais la démo).
PAYMENT_MODE=demo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Webhook Stripe Connect (événements des comptes connectés des organismes) : c'est CE secret qui compte pour les dons.
# Chez Stripe : un point d'entrée « Connect » vers /api/webhook/stripe avec checkout.session.completed,
# checkout.session.async_payment_succeeded, charge.refunded et account.updated.
STRIPE_CONNECT_WEBHOOK_SECRET=
# Tableau de bord des comptes d'organismes créés : express (défaut, allégé, ouvert depuis la console) ou full (complet, sur stripe.com).
# Il ne change jamais après la création d'un compte.
STRIPE_ACCOUNT_DASHBOARD=express
# Si Stripe refuse « Express + frais payés par le compte », fixer la version d'API récente pour la création des comptes seulement.
STRIPE_CONNECT_API_VERSION=

# ── Console admin (/admin) ──
ADMIN_CODE=
# Longue chaîne aléatoire (32 caractères ou plus) qui signe la session admin
SESSION_SECRET=

# ── Courriels (facultatif en développement : sans clé, ils s'écrivent dans la console du serveur) ──
RESEND_API_KEY=
# Adresse d'envoi sur un domaine vérifié chez Resend (ex. dons@studioexistence.com) : l'expéditeur affiche le nom de l'organisme.
# Sans elle, l'adresse d'essai de Resend (onboarding@resend.dev) n'envoie qu'à l'adresse du compte.
EMAIL_FROM_ADDRESS=
# Facultatif : « Nom <adresse> » complet, qui remplace les deux lignes ci-dessus.
EMAIL_FROM=
# Secret de signature (whsec_…) du webhook Resend vers /api/webhook/resend : suivi livré / rebond / plainte dans le journal.
RESEND_WEBHOOK_SECRET=

# ── Rappel du lendemain (Vercel Cron, chaque jour à 14 h UTC) ──
# Longue chaîne aléatoire : Vercel l'envoie en « Authorization: Bearer … » ; sans elle, la tâche refuse d'agir.
CRON_SECRET=
# 0 : coupe les rappels
REMINDERS_ENABLED=

# Multi-organismes : l'organisme vient du sous-domaine (<identifiant>.PLATFORM_DOMAIN).
# PLATFORM_DOMAIN : le domaine de la plateforme, sans « https:// » (ex. donivers.com ; « localhost » en développement).
# Vide = pas de sous-domaines : tout va à l'organisme par défaut.
PLATFORM_DOMAIN=
# Organisme servi par toute adresse inconnue (vitrail.studioexistence.com, *.vercel.app, localhost) ; sélecteur des prévisualisations.
DEFAULT_ORG_SLUG=ecoleartsutton
